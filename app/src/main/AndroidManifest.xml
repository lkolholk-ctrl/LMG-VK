<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Разрешения (VK API + плеер + загрузки) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- Локальная библиотека (LocalLibraryScreen): аудио на Android 13+ -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <!-- Запрос исключения из Doze: фоновые декод-потоки/сеть стриминга -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Android 11+ фильтрует видимость пакетов: без этого блока
         queryIntentActivities не находит браузер, и запасной путь
         VkLinkResolver.openOutside (открыть ссылку вне приложения) молча падал бы
         в «браузер не найден». Спрашиваем ровно про обработчиков https-ссылок. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:name=".LmgApplication"
        android:allowBackup="true"
        android:icon="@drawable/launcher_icon_sunset"
        android:roundIcon="@drawable/launcher_icon_sunset"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.LmgVk">

        <!-- Шаринг PNG-карточек лирики (LyricShareCard) -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|density|uiMode"
            android:windowSoftInputMode="adjustResize">

            <!-- Ссылки ВКонтакте (порт VK X: те же префиксы путей, что в его
                 манифесте — /audio*, /music*, /artist/*). Один фильтр вместо
                 восьми: Android перемножает все scheme × host × path внутри
                 фильтра, поведение то же.

                 ВАЖНО: перехватываем ТОЛЬКО музыкальные префиксы. Фильтр на весь
                 vk.com предлагал бы LMG VK на любую ссылку (посты, профили,
                 видео) — этого пользователи не прощают. Обратная сторона: короткие
                 ссылки вида vk.com/somename сюда не попадают, хотя резолвер их
                 разбирает (utils.resolveScreenName) — они приходят к нам только
                 через `z=`-параметр музыкального пути.

                 autoVerify намеренно false (как у VK X): это НЕ верифицированные
                 App Links — мы не владеем vk.com и не можем положить туда
                 assetlinks.json, поэтому остаёмся в списке выбора приложения. -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <!-- http тоже: старые ссылки из переписок приходят без TLS. -->
                <data android:scheme="https" />
                <data android:scheme="http" />
                <data android:host="vk.com" />
                <data android:host="m.vk.com" />
                <data android:host="vk.ru" />
                <data android:host="m.vk.ru" />
                <!-- /audio123_456, /audio_playlist…, /audios123, /audiobook… -->
                <data android:pathPrefix="/audio" />
                <!-- /music, /music/album/…, /music/playlist/…, /music?z=… -->
                <data android:pathPrefix="/music" />
                <data android:pathPrefix="/artist/" />
            </intent-filter>
        </activity>

        <!-- Один alias включён всегда: Settings переключает их для смены иконки. -->
        <activity-alias
            android:name=".LauncherIconSunset"
            android:targetActivity=".MainActivity"
            android:enabled="true"
            android:exported="true"
            android:icon="@drawable/launcher_icon_sunset"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherIconEmerald"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/launcher_icon_emerald"
            android:label="@string/app_name"><intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter></activity-alias>
        <activity-alias
            android:name=".LauncherIconLagoon"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/launcher_icon_lagoon"
            android:label="@string/app_name"><intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter></activity-alias>
        <activity-alias
            android:name=".LauncherIconAmethyst"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/launcher_icon_amethyst"
            android:label="@string/app_name"><intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter></activity-alias>
        <activity-alias
            android:name=".LauncherIconPrism"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/launcher_icon_prism"
            android:label="@string/app_name"><intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter></activity-alias>
        <activity-alias
            android:name=".LauncherIconNeon"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/launcher_icon_neon"
            android:label="@string/app_name"><intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter></activity-alias>
        <activity-alias
            android:name=".LauncherIconFuchsia"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/launcher_icon_fuchsia"
            android:label="@string/app_name"><intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter></activity-alias>
        <activity-alias
            android:name=".LauncherIconAmber"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/launcher_icon_amber"
            android:label="@string/app_name"><intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter></activity-alias>
        <activity-alias
            android:name=".LauncherIconRuby"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/launcher_icon_ruby"
            android:label="@string/app_name"><intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter></activity-alias>
        <activity-alias
            android:name=".LauncherIconGraphite"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/launcher_icon_graphite"
            android:label="@string/app_name"><intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter></activity-alias>
        <activity-alias
            android:name=".LauncherIconRose"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/launcher_icon_rose"
            android:label="@string/app_name"><intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter></activity-alias>
        <activity-alias
            android:name=".LauncherIconCobalt"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/launcher_icon_cobalt"
            android:label="@string/app_name"><intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter></activity-alias>
        <activity-alias
            android:name=".LauncherIconPearl"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/launcher_icon_pearl"
            android:label="@string/app_name"><intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter></activity-alias>

        <!-- Экран краша: java_crash-логи + native/ANR-дампы Fishnet -->
        <activity
            android:name="com.lmg.vk.ui.crash.CrashActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTop" />

        <!-- Основной плеер: LMG engine.AudioService (Media3) -->
        <service
            android:name=".engine.AudioService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback"
            android:priority="1000">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
                <!-- MediaBrowserService action намеренно убран (см. LMG): на OEM
                     (Honor/Huawei) system media-resumption биндится к browsable
                     сервису при холодном старте и гоняет ExoPlayer за CMA → ANR. -->
            </intent-filter>
        </service>

        <!-- Восстановленный стек VK X (референс; merge в engine.AudioService) -->
        <service
            android:name="com.lmg.vk.playback.PlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Загрузки треков -->
        <service
            android:name="com.lmg.vk.downloader.DownloaderService"
            android:exported="false" />

        <!-- Загрузки плейлистов (engine) -->
        <service
            android:name=".engine.PlaylistDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- MediaButtonReceiver — нужен OEM (Huawei/Honor) для ComponentName -->
        <receiver
            android:name="androidx.media3.session.MediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
